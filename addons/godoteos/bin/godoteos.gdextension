[configuration]

entry_symbol = "godoteos_library_init"
compatibility_minimum = "4.3"
reloadable = true

[icons]
GodotEOS = "res://addons/godoteos/icon.png"

[libraries]

macos.debug = "res://addons/godoteos/bin/macos/libgodoteos.macos.template_debug.framework"
macos.release = "res://addons/godoteos/bin/macos/libgodoteos.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/godoteos/bin/windows/libgodoteos.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godoteos/bin/windows/libgodoteos.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/godoteos/bin/linux/libgodoteos.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/godoteos/bin/linux/libgodoteos.linux.template_release.x86_64.so"

[dependencies]
ios.debug = {
    "res://addons/godoteos/bin/macos/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
    "res://addons/godoteos/bin/macos/libgodot-cpp.ios.template_release.xcframework": ""
}