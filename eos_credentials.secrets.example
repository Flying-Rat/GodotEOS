; Copy this file to eos_credentials.secrets (drop the .example suffix) and fill
; in the values from your product in the Epic Developer Portal.
;
; eos_credentials.secrets is gitignored - never commit real credentials.
;
; Every value must be wrapped in double quotes, e.g. product_id="abc123".
;
; NOTE: this file lives under res://, which means an exported build embeds it in
; the PCK where a client_secret is trivially recoverable. That is fine for this
; editor-run demo. For a shipping game, load credentials from user:// or an
; environment variable instead, or use a backend that never exposes the secret.

[eos]

; Optional. Shown to Epic; defaults are used if left blank.
product_name="My Game"
product_version="1.0.0"

; Required. All four identify the same product/sandbox in the Developer Portal.
product_id=""
sandbox_id=""
deployment_id=""

; Required. Client credentials for that product.
client_id=""
client_secret=""

; Optional. Leave blank unless you use Player Data Storage or Title Storage.
; If set, it must be exactly 64 hexadecimal characters - an empty-but-present
; value is rejected by EOS with "Encryption key cannot be empty".
encryption_key=""
